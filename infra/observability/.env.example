# Copy to .env (gitignored). Production values live only in Coolify (D54).
GLITCHTIP_DB_PASSWORD=change-me
# Generate: openssl rand -base64 48
GLITCHTIP_SECRET_KEY=change-me
GLITCHTIP_DOMAIN=https://errors.example.com
GLITCHTIP_FROM_EMAIL=errors@example.com
# SMTP for alerts, e.g. smtp://user:pass@smtp.host:587 ; consolemail:// just logs.
GLITCHTIP_EMAIL_URL=consolemail://
