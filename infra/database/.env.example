# Copy to .env (gitignored). Local/laptop values shown; production values live only
# in Coolify environment variables, scoped per environment (D54, ARCH §20).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_DB=kantorcore

# App connection strings go through PgBouncer (port 6432). Example:
#   DATABASE_URL=postgres://kc_tenant:...@pgbouncer:6432/kantorcore
