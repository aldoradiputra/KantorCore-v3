# pgBackRest config template (D49). Copy to /etc/pgbackrest/pgbackrest.conf on the
# database host and fill the repo credentials. PITR to object storage in a SEPARATE
# bucket with its own credentials. On Biznet this is NEO Object Storage (S3 API);
# the laptop stand-in can point at any S3-compatible bucket (or a local repo path).
[global]
repo1-type=s3
repo1-s3-endpoint=<neo-endpoint>            # e.g. https://s3.nos.biznetgio.com
repo1-s3-region=<region>
repo1-s3-bucket=<kantorcore-pgbackrest>     # dedicated backup bucket, own credentials
repo1-path=/kantorcore
repo1-retention-full=4                       # keep 4 full backups
repo1-retention-diff=8
# repo1-s3-key / repo1-s3-key-secret: set via environment, never in this file (D54)
start-fast=y
process-max=2

[global:archive-push]
compress-type=zst

[kantorcore]
pg1-path=/var/lib/postgresql/18/docker      # adjust to the data dir on the host
pg1-port=5432
