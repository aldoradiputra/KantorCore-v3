# Copy to .env for local development. Never commit real secrets (D54).
# Local docker-compose Postgres (dev-only credentials from packages/db/sql/bootstrap.sql).

# App (tenant plane) connection — RLS-enforced role.
DATABASE_URL=postgres://kc_tenant:kc_tenant_dev@localhost:5432/kantorcore

# Migration runner (CI migrate step / local `pnpm db:migrate`).
MIGRATOR_DATABASE_URL=postgres://kc_migrator:kc_migrator_dev@localhost:5432/kantorcore

# Control plane connection.
CONTROL_DATABASE_URL=postgres://kc_control:kc_control_dev@localhost:5432/kantorcore
